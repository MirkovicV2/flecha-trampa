# URL completa de la instalación pública. Necesaria para compartir desde una app nativa.
# No contiene secretos. Vite expone todas las variables VITE_* al cliente.
# VITE_PUBLIC_URL=https://tu-dominio.example/flecha-trampa/
# Vista previa interna: anuncios y compra del pase simulados, etiquetados, sin cobro.
# VITE_MONETIZATION_MODE=preview
# Para desactivar el simulador por completo, usa disabled (cualquier otro valor también lo desactiva).
